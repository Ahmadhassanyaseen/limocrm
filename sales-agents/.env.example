# Operator UI
APP_HOST=127.0.0.1
APP_PORT=8787
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=America/New_York
# Optional: require ?token= or Authorization header for the UI
OPERATOR_TOKEN=

# Brand / CAN-SPAM (required before sending email)
SENDER_NAME=Avery Chen
SENDER_EMAIL=avery@limogen.io
COMPANY_LEGAL_NAME=LimoGen
MAILING_ADDRESS=123 Operator Ave, Suite 100, Austin, TX 78701
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Product CTAs
EXPLORE_DEMO_BASE_URL=http://localhost/limocrm/login_explore.php
CALENDAR_URL=
BROCHURE_NOTE=I can send the module brochure (lead → quote → sign → pay) if useful.

# LLM (optional — template copy is used when empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Email send (use Resend and/or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Email replies
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Hunter / research
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=

# SMS / WhatsApp (opt-in only — never used for cold outreach)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=limogen_followup
# Set true in tests to skip APScheduler
# DISABLE_SCHEDULER=false
